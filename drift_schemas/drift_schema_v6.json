  "fixed_sql": [
    {
      "name": "app_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_metadata\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"is_completed\" INTEGER NOT NULL CHECK (\"is_completed\" IN (0, 1)), \"priority\" INTEGER NOT NULL CHECK(priority BETWEEN 0 AND 3), \"workflow_status\" INTEGER NOT NULL DEFAULT 0 CHECK(workflow_status BETWEEN 0 AND 2), \"due_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"completed_at\" TEXT NULL, \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"is_completed\" INTEGER NOT NULL CHECK (\"is_completed\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "completion_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completion_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NULL, \"task_title\" TEXT NOT NULL, \"completed_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "task_extras",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_extras\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"recurrence\" TEXT NULL, \"monthly_anchor_day\" INTEGER NULL, \"reminder_at\" TEXT NULL, \"reminder_repeat_minutes\" INTEGER NULL, \"reminder_snoozed_until\" TEXT NULL, PRIMARY KEY (\"task_id\"));"
        }
      ]
    },
    {
      "name": "task_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_tags\" (\"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"task_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "task_attachments",
      "sql": [

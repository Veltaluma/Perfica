<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/perfica_widget_task_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="5dp"
    android:paddingEnd="2dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@+id/perfica_widget_task_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/perfica_widget_toggle_completion"
        android:padding="9dp"
        android:src="@drawable/ic_perfica_widget_unchecked" />

    <LinearLayout
        android:id="@+id/perfica_widget_task_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/perfica_widget_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/perfica_widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/perfica_widget_task_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/perfica_widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/perfica_widget_task_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/perfica_widget_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/perfica_widget_task_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/perfica_widget_text_secondary"
            android:textSize="10sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/perfica_widget_task_expand"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:text="▼"
        android:textColor="@color/perfica_widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
